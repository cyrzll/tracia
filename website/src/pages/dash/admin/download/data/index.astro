---
import fs from 'node:fs';
import path from 'node:path';
import { validateAdminSession } from '@/utils/auth';

// 1. Auth check: Hanya admin terverifikasi yang diperbolehkan mengunduh database
const { isLoggedIn, adminInfo } = await validateAdminSession(Astro.cookies);
if (!isLoggedIn || !adminInfo) {
  return new Response('Unauthorized. Please log in as admin.', { status: 401 });
}

// 2. Resolve database path
const envDbFile = process.env.ASTRO_DATABASE_FILE || 'local.db';
const dbPath = path.isAbsolute(envDbFile) 
  ? envDbFile 
  : path.resolve(process.cwd(), envDbFile);

if (!fs.existsSync(dbPath)) {
  return new Response(`Database file not found at: ${dbPath}`, { status: 404 });
}

try {
  const fileBuffer = fs.readFileSync(dbPath);
  return new Response(fileBuffer, {
    headers: {
      'Content-Type': 'application/x-sqlite3',
      'Content-Disposition': 'attachment; filename="local.db"',
      'Cache-Control': 'no-cache, no-store, must-revalidate',
    },
  });
} catch (error: any) {
  return new Response(`Error reading database file: ${error.message}`, { status: 500 });
}
---
