---
import Layout from '../../../layouts/Layout.astro';
import { validateAdminSession, clearAdminSession } from '../../../utils/auth';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Table, TableHeader, TableBody, TableRow, TableHead, TableCell } from '@/components/ui/table';
import { KrsAccordion } from '@/components/KrsAccordion';
import { TranscriptView } from '@/components/TranscriptView';
import { db } from '../../../lib/db';
import { Mhs, MhsKrs, MhsTranscript, MhsBilling } from '../../../lib/schema';
import { eq } from 'drizzle-orm';

// 1. Authentication Check
const { isLoggedIn, adminInfo } = await validateAdminSession(Astro.cookies);
if (!isLoggedIn || !adminInfo) {
  return Astro.redirect('/login');
}

// 2. Logout handling
if (Astro.url.searchParams.get('action') === 'logout') {
  clearAdminSession(Astro.cookies);
  return Astro.redirect('/login');
}

// 3. Fetch All Students from DB
const dbStudents = await db.select().from(Mhs);

// 4. Get Selected Student NIM from Query Parameters
let selectedNim = Astro.url.searchParams.get('nim');
if (!selectedNim && dbStudents.length > 0) {
  selectedNim = dbStudents[0].nim;
}

// 5. Fetch Details for Selected Student
let selectedStudent = null;
let currentKrsData = null;
let pastKrsData = null;
let billingData = null;
let transcriptData = null;
let khsHeaderData = null;

// Health state variables for Visual Metaphor
let isBrainHealthy = true;
let isHeartHealthy = true;
let isHandsHealthy = true;
let isFeetHealthy = true;
let velocity = 0.0;

if (selectedNim) {
  const found = dbStudents.find(s => s.nim === selectedNim);
  if (found) {
    selectedStudent = found;

    // Fetch related records in parallel
    const [dbKrs, dbTranscript, dbBilling] = await Promise.all([
      db.select().from(MhsKrs).where(eq(MhsKrs.nim, selectedNim)),
      db.select().from(MhsTranscript).where(eq(MhsTranscript.nim, selectedNim)),
      db.select().from(MhsBilling).where(eq(MhsBilling.nim, selectedNim)).limit(1)
    ]);

    // Reconstruct KRS structure
    const krsMap = new Map<string, any[]>();
    dbKrs.forEach(row => {
      if (!krsMap.has(row.ta)) {
        krsMap.set(row.ta, []);
      }
      krsMap.get(row.ta)!.push({
        kdmk: row.kdmk,
        nmmk: row.nmmk,
        klpk: row.klpk,
        sks: row.sks,
        sts: row.status
      });
    });

    const pastKrsList: any[] = [];
    const sortedTas = Array.from(krsMap.keys()).sort();
    sortedTas.forEach((ta, idx) => {
      const isLast = idx === sortedTas.length - 1;
      const semKrs = {
        ta: ta,
        kode_ta: ta,
        krs: krsMap.get(ta)!
      };
      if (isLast) {
        currentKrsData = semKrs;
      } else {
        pastKrsList.push(semKrs);
      }
    });
    pastKrsData = pastKrsList;

    // Reconstruct Transcript & KHS header format
    transcriptData = dbTranscript.map(row => ({
      kdmk: row.kdmk,
      nmmk: row.nmmk,
      sks: row.sks,
      nl: row.nilai
    }));

    const totalSks = transcriptData.reduce((sum, item) => sum + Number(item.sks), 0);
    const gradeCounts = new Map<string, number>();
    transcriptData.forEach(item => {
      gradeCounts.set(item.nl, (gradeCounts.get(item.nl) || 0) + 1);
    });
    const total_nilai = Array.from(gradeCounts.entries()).map(([nilai, jumlah]) => ({
      nilai,
      jumlah
    }));

    khsHeaderData = {
      total_sks: totalSks,
      ipk: selectedStudent.gpa,
      total_nilai
    };

    // Reconstruct Billing format
    if (dbBilling.length > 0) {
      const b = dbBilling[0];
      billingData = {
        status: b.status,
        total_tagih: b.totalTagih,
        informasi: b.informasi,
        tahun_ajaran: b.ta,
        status_pembayaran: b.status.includes("TERBAYAR") ? "LUNAS" : "UTS",
        via: b.via,
        tanggal: b.tanggal,
        SKS_sekarang: 0,
        SPP_sekarang: 0,
        GDG_sekarang: 0,
        MOD_sekarang: 0,
        BK_sekarang: 0,
        POLI_sekarang: 0
      };
    }

    // Set Visual Indicators
    isBrainHealthy = selectedStudent.gpa >= 3.0;
    isHeartHealthy = billingData && billingData.status.includes("TERBAYAR");
    isHandsHealthy = transcriptData.filter(c => c.nl === 'D' || c.nl === 'E').length === 0;
    velocity = selectedStudent.semester > 1 ? selectedStudent.sks / (selectedStudent.semester - 1) : selectedStudent.sks;
    isFeetHealthy = velocity >= 12;
  }
}

const formatRupiah = (value: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(value);
};
---

<Layout title="Admin Dashboard | Student Risk Predictor">
  <div class="min-h-screen bg-zinc-50 text-zinc-800 font-sans">
    <!-- Navbar -->
    <nav class="border-b border-zinc-200 bg-white/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 border-2 border-zinc-900 flex items-center justify-center bg-zinc-900">
              <span class="text-white font-black text-xs">T</span>
            </div>
            <span class="font-bold text-sm tracking-wider text-zinc-900">TRACIA AI</span>
          </div>

          <div class="flex items-center gap-4">
            <!-- Admin Profile Display -->
            <div class="hidden sm:flex flex-col items-end text-right">
              <span class="text-xs font-semibold text-zinc-900">{adminInfo.name}</span>
              <span class="text-[9px] uppercase font-bold text-zinc-500 tracking-wider">{adminInfo.level}</span>
            </div>
            <div class="w-8 h-8 rounded border border-zinc-200 bg-zinc-100 flex items-center justify-center">
              <span class="text-xs font-bold text-zinc-700">AD</span>
            </div>
            
            <div class="border-l border-zinc-200 h-5 mx-1"></div>
            

            <!-- Logout Button -->
            <Button
              variant="outline"
              size="sm"
              className="h-8 text-[11px] gap-1 px-3 py-1 bg-white text-zinc-650 border-zinc-200 hover:bg-zinc-50 hover:text-zinc-900"
              asChild
            >
              <a href="?action=logout" class="flex items-center gap-1.5 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                </svg>
                Logout
              </a>
            </Button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Welcome Header -->
      <div class="mb-8 border-b border-zinc-200 pb-6">
        <h1 class="text-2xl font-bold text-zinc-900 tracking-tight">DASHBOARD MONITORING RISIKO (ADMIN)</h1>
        <p class="text-xs text-zinc-500 mt-1">Sistem Pemantauan Akademis Terintegrasi &bull; Administrator: {adminInfo.name}</p>
      </div>

      <!-- Main Layout Grid: Left list, Right details -->
      <div class="grid grid-cols-1 xl:grid-cols-3 gap-8 items-start">
        
        <!-- Left Side: Student List (1 column on XL, full width otherwise) -->
        <div class="xl:col-span-1 space-y-6">
          <Card className="shadow-sm border border-zinc-200 bg-white overflow-hidden">
            <CardHeader className="bg-zinc-50/50 border-b border-zinc-200 p-4">
              <CardTitle className="text-xs font-bold text-zinc-900 uppercase tracking-wide">Daftar Pengawasan Mahasiswa</CardTitle>
              <CardDescription className="text-[10px] text-zinc-500">Mahasiswa terdaftar di database local.db</CardDescription>
            </CardHeader>
            <CardContent className="p-0">
              {dbStudents.length === 0 ? (
                <div class="p-6 text-center text-zinc-500 text-xs font-medium">
                  Belum ada data mahasiswa di database. Mahasiswa perlu melakukan login terlebih dahulu agar data profil & akademis masuk ke database.
                </div>
              ) : (
                <div class="max-h-[600px] overflow-y-auto">
                  <Table>
                    <TableHeader className="bg-zinc-50">
                      <TableRow className="border-b border-zinc-200 hover:bg-transparent">
                        <TableHead className="px-4 py-2.5 text-zinc-500 text-[10px]">Mahasiswa</TableHead>
                        <TableHead className="px-4 py-2.5 text-zinc-500 text-[10px] text-center">Risiko</TableHead>
                        <TableHead className="px-4 py-2.5 text-zinc-500 text-[10px] text-right">Aksi</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {dbStudents.map((s) => (
                        <TableRow 
                          className={`border-b border-zinc-100 hover:bg-zinc-50/40 transition-all ${
                            s.nim === selectedNim ? 'bg-zinc-100/50 font-bold' : ''
                          }`}
                        >
                          <TableCell className="px-4 py-3">
                            <div class="flex items-center gap-2">
                              <img 
                                src={s.foto} 
                                alt={s.nama} 
                                class="w-7 h-7 rounded border border-zinc-200 object-cover bg-zinc-50 grayscale"
                              />
                              <div>
                                <div class="text-[11px] font-semibold text-zinc-900 truncate max-w-[120px]">{s.nama}</div>
                                <div class="text-[9px] text-zinc-400 font-mono mt-0.5">{s.nim}</div>
                              </div>
                            </div>
                          </TableCell>
                          <TableCell className="px-4 py-3 text-center">
                            <Badge 
                              className={`text-[8px] px-1.5 py-0.5 font-bold uppercase ${
                                s.risk_level === 'Low'
                                  ? 'bg-zinc-50 text-zinc-800 border border-zinc-300'
                                  : s.risk_level === 'Medium'
                                  ? 'bg-zinc-850 text-zinc-50'
                                  : 'bg-zinc-950 text-zinc-50 border-2 border-black'
                              }`}
                            >
                              {s.risk_level === 'Low' ? 'Rendah' : s.risk_level === 'Medium' ? 'Sedang' : 'Tinggi'}
                            </Badge>
                          </TableCell>
                          <TableCell className="px-4 py-3 text-right">
                            <Button 
                              variant="outline" 
                              size="sm" 
                              className="h-7 text-[9px] px-2 py-0 border-zinc-200 hover:bg-zinc-100"
                              asChild
                            >
                              <a href={`?nim=${s.nim}`}>Pilih</a>
                            </Button>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </div>
              )}
            </CardContent>
          </Card>

          <!-- System Insight Card -->
          <Card className="shadow-sm border border-zinc-200 bg-white">
            <CardHeader className="p-4">
              <CardTitle className="text-xs font-bold text-zinc-900 uppercase tracking-wider">Metrik Status Integrasi</CardTitle>
              <CardDescription className="text-xs text-zinc-500 leading-relaxed mt-2">
                Tabel di atas disinkronisasi secara otomatis saat mahasiswa login melalui akun portal SIADIN mereka.
              </CardDescription>
            </CardHeader>
          </Card>
        </div>

        <!-- Right Side: Detailed View (2 columns on XL, full width otherwise) -->
        <div class="xl:col-span-2 space-y-8">
          {selectedStudent ? (
            <>
              <!-- Profile Header Row (styled like student's profile grid) -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Foto Card -->
                <div class="md:col-span-1">
                  <Card className="shadow-sm border border-zinc-200 bg-white p-5 flex flex-col items-center text-center">
                    <div class="w-24 h-24 rounded border border-zinc-200 overflow-hidden bg-zinc-50 mb-3 relative shadow-inner">
                      <img 
                        src={selectedStudent.foto} 
                        alt={selectedStudent.nama} 
                        class="w-full h-full object-cover grayscale"
                      />
                    </div>
                    <h2 class="text-xs font-bold text-zinc-900 uppercase tracking-wide leading-snug">{selectedStudent.nama}</h2>
                    <p class="text-[10px] text-zinc-500 font-mono mt-1">{selectedStudent.nim}</p>
                    <Button
                      id="btn-open-email-modal"
                      className="mt-4 w-full text-[11px] h-8 bg-zinc-950 text-zinc-50 hover:bg-zinc-800 transition-all font-semibold rounded flex items-center justify-center gap-1.5 cursor-pointer"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                      </svg>
                      Kirim Email
                    </Button>
                  </Card>
                </div>

                <!-- Detail Profile Grid -->
                <div class="md:col-span-2">
                  <Card className="shadow-sm border border-zinc-200 bg-white h-full">
                    <CardHeader className="border-b border-zinc-150 p-4 bg-zinc-50/50">
                      <CardTitle className="text-xs font-bold text-zinc-900 uppercase tracking-wide">Informasi Mahasiswa Terpilih</CardTitle>
                    </CardHeader>
                    <CardContent className="p-5 space-y-4">
                      <div class="grid grid-cols-2 gap-4 text-xs">
                        <div>
                          <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider">Nama Lengkap</span>
                          <span class="text-xs font-semibold text-zinc-900 block mt-0.5">{selectedStudent.nama}</span>
                        </div>
                        <div>
                          <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider">NIM</span>
                          <span class="text-xs font-mono font-semibold text-zinc-900 block mt-0.5">{selectedStudent.nim}</span>
                        </div>
                        <div>
                          <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider">Email Kampus</span>
                          <span class="text-xs font-mono text-zinc-900 block mt-0.5">{selectedStudent.email}</span>
                        </div>
                        <div>
                          <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider">Jenis Kelamin</span>
                          <span class="text-xs font-semibold text-zinc-900 block mt-0.5">
                            {selectedStudent.gender === 'L' ? 'Laki-laki' : selectedStudent.gender === 'P' ? 'Perempuan' : selectedStudent.gender}
                          </span>
                        </div>
                      </div>
                    </CardContent>
                  </Card>
                </div>
              </div>

              <!-- Dropout Risk AI Prediction Card -->
              <Card className="shadow-sm border border-zinc-200 bg-white">
                <CardHeader className="border-b border-zinc-150 p-4 bg-zinc-50/50">
                  <div class="flex justify-between items-center">
                    <div>
                      <CardTitle className="text-xs font-bold text-zinc-900 uppercase tracking-wide">Analisis Risiko Akademik (AI Dropout Prediction)</CardTitle>
                      <CardDescription className="text-[10px] text-zinc-500 mt-1 leading-snug">Deteksi tingkat kerawanan dropout mahasiswa secara visual.</CardDescription>
                    </div>
                    <Badge 
                      className={`text-[9px] px-2 py-0.5 font-bold uppercase border-zinc-300 ${
                        selectedStudent.risk_level === "Low" 
                          ? "bg-zinc-50 text-zinc-800" 
                          : selectedStudent.risk_level === "Medium"
                          ? "bg-zinc-850 text-zinc-50"
                          : "bg-zinc-950 text-zinc-50 border-2 border-black"
                      }`}
                    >
                      Risiko {selectedStudent.risk_level === "Low" ? "Rendah" : selectedStudent.risk_level === "Medium" ? "Sedang" : "Tinggi"}
                    </Badge>
                  </div>
                </CardHeader>
                <CardContent className="p-6">
                  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-stretch">
                    <!-- Probability Circle/Display -->
                    <div class="lg:col-span-1 text-center lg:border-r lg:border-zinc-200 lg:pr-6 flex flex-col justify-center items-center">
                      <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Probabilitas Dropout</span>
                      <span class="text-4xl font-black text-zinc-950 tracking-tighter block mt-2">{(selectedStudent.risk_probability * 100).toFixed(2)}%</span>
                      <div class="w-full bg-zinc-100 h-2 rounded-full overflow-hidden mt-4 mx-auto max-w-[150px]">
                        <div 
                          class={`h-full rounded-full transition-all duration-300 ${
                            selectedStudent.risk_level === "Low" 
                              ? "bg-zinc-400" 
                              : selectedStudent.risk_level === "Medium" 
                              ? "bg-zinc-700" 
                              : "bg-zinc-950"
                          }`}
                          style={{ width: `${(selectedStudent.risk_probability * 100)}%` }}
                        />
                      </div>
                    </div>

                    <!-- AI Input Breakdown -->
                    <div class="lg:col-span-2 space-y-4 flex flex-col justify-between">
                      <div>
                        <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Hasil Analisis Model</span>
                        <p class="text-xs text-zinc-655 mt-1.5 leading-relaxed font-medium">
                          {selectedStudent.risk_level === "Low" ? (
                            "Performa akademik mahasiswa berada dalam kondisi aman dengan tingkat kestabilan tinggi. Disarankan untuk tetap mempertahankan pencapaian SKS dan IPK pada semester berikutnya."
                          ) : selectedStudent.risk_level === "Medium" ? (
                            "Model mendeteksi adanya indikator risiko dropout tingkat menengah. Disarankan untuk meninjau kembali tingkat kehadiran kuliah, tren pencapaian IPK, serta memastikan tidak ada pembayaran tagihan yang terlambat."
                          ) : (
                            "PENTING: Model mendeteksi tingkat risiko dropout yang tinggi. Hal ini dipicu oleh tren penurunan IPK yang signifikan, adanya mata kuliah yang tidak lulus, keterlambatan pembayaran biaya kuliah, atau tingkat kehadiran yang rendah. Segera jadwalkan bimbingan akademik dengan Dosen Wali."
                          )}
                        </p>
                      </div>

                      <div class="border-t border-zinc-150 pt-3">
                        <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider mb-2">Parameter Input AI</span>
                        <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-[10px] font-mono text-zinc-500">
                          <div>
                            <span class="text-zinc-400">Semester:</span>
                            <span class="font-bold text-zinc-800 ml-1">{selectedStudent.semester}</span>
                          </div>
                          <div>
                            <span class="text-zinc-400">IPK Kumulatif:</span>
                            <span class="font-bold text-zinc-800 ml-1">{selectedStudent.gpa.toFixed(2)}</span>
                          </div>
                          <div>
                            <span class="text-zinc-400">Kehadiran (Rasio):</span>
                            <span class="font-bold text-zinc-800 ml-1">95.00%</span>
                          </div>
                          <div>
                            <span class="text-zinc-400">Kecepatan SKS:</span>
                            <span class="font-bold text-zinc-800 ml-1">{velocity.toFixed(2)}/sem</span>
                          </div>
                          <div>
                            <span class="text-zinc-400">MK Gagal:</span>
                            <span class="font-bold text-zinc-800 ml-1">{transcriptData ? transcriptData.filter(c => c.nl === 'D' || c.nl === 'E').length : 0}</span>
                          </div>
                          <div>
                            <span class="text-zinc-400">Status Bayar:</span>
                            <span class="font-bold text-zinc-800 ml-1">{billingData && billingData.status.includes("TERBAYAR") ? "Paid" : "Unpaid"}</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- SVG Anatomy Visualization -->
                    <div class="lg:col-span-1 flex flex-col items-center justify-center lg:border-l lg:border-zinc-200 lg:pl-6 py-2">
                      <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider mb-3 text-center w-full">Visualisasi Anatomi Risiko</span>
                      
                      <div class="flex items-center gap-4 w-full justify-between">
                        <div class="relative flex-shrink-0">
                          <svg viewBox="0 0 120 220" class="w-16 h-auto text-zinc-900" fill="none" stroke="currentColor" stroke-width="1.5">
                            <!-- Head -->
                            <circle cx="60" cy="30" r="14" class="stroke-zinc-200" />
                            <!-- Spine / Neck -->
                            <line x1="60" y1="44" x2="60" y2="60" class="stroke-zinc-200" />
                            <!-- Torso -->
                            <path d="M 45 60 L 75 60 L 70 120 L 50 120 Z" class="stroke-zinc-200 fill-zinc-50/20" />
                            <!-- Arms -->
                            <path d="M 43 60 C 30 80, 28 100, 32 120" class="stroke-zinc-200" />
                            <path d="M 77 60 C 90 80, 92 100, 88 120" class="stroke-zinc-200" />
                            <!-- Legs -->
                            <path d="M 52 120 L 48 160 L 50 200" class="stroke-zinc-200" />
                            <path d="M 68 120 L 72 160 L 70 200" class="stroke-zinc-200" />
                            
                            <!-- Brain Node -->
                            {isBrainHealthy ? (
                              <circle cx="60" cy="30" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                            ) : (
                              <g>
                                <circle cx="60" cy="30" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                                <circle cx="60" cy="30" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                              </g>
                            )}

                            <!-- Heart Node -->
                            {isHeartHealthy ? (
                              <circle cx="60" cy="75" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                            ) : (
                              <g>
                                <circle cx="60" cy="75" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                                <circle cx="60" cy="75" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                              </g>
                            )}

                            <!-- Hands Nodes -->
                            {isHandsHealthy ? (
                              <>
                                <circle cx="32" cy="120" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                                <circle cx="88" cy="120" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                              </>
                            ) : (
                              <g>
                                <circle cx="32" cy="120" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                                <circle cx="32" cy="120" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                                
                                <circle cx="88" cy="120" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                                <circle cx="88" cy="120" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                              </g>
                            )}

                            <!-- Feet Nodes -->
                            {isFeetHealthy ? (
                              <>
                                <circle cx="50" cy="200" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                                <circle cx="70" cy="200" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                              </>
                            ) : (
                              <g>
                                <circle cx="50" cy="200" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                                <circle cx="50" cy="200" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                                
                                <circle cx="70" cy="200" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                                <circle cx="70" cy="200" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                              </g>
                            )}
                          </svg>
                        </div>

                        <!-- Mini bullet indicators -->
                        <div class="flex-1 space-y-3 text-[10px] leading-snug">
                          <div class="flex flex-col gap-0.5">
                            <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                              🧠 Otak (GPA)
                              <span class={`w-1.5 h-1.5 rounded-full ${isBrainHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                            </span>
                            <span class="text-zinc-500 font-mono pl-4">{selectedStudent.gpa.toFixed(2)} IPK</span>
                          </div>
                          <div class="flex flex-col gap-0.5">
                            <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                              ❤️ Jantung (Bayar)
                              <span class={`w-1.5 h-1.5 rounded-full ${isHeartHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                            </span>
                            <span class="text-zinc-500 pl-4">{isHeartHealthy ? "Lunas" : "Tunggakan"}</span>
                          </div>
                          <div class="flex flex-col gap-0.5">
                            <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                              💪 Tangan (SKS)
                              <span class={`w-1.5 h-1.5 rounded-full ${isHandsHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                            </span>
                            <span class="text-zinc-500 pl-4">{selectedStudent.sks} SKS ({transcriptData ? transcriptData.filter(c => c.nl === 'D' || c.nl === 'E').length : 0} MK Gagal)</span>
                          </div>
                          <div class="flex flex-col gap-0.5">
                            <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                              👣 Kaki (Hadir)
                              <span class={`w-1.5 h-1.5 rounded-full ${isFeetHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                            </span>
                            <span class="text-zinc-500 font-mono pl-4">95% ({velocity.toFixed(1)}/sem)</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <!-- Academics & Financial Grid -->
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- KRS Accordion -->
                <div class="lg:col-span-2 space-y-4">
                  <div class="border-b border-zinc-200 pb-3">
                    <h2 class="text-sm font-bold text-zinc-900 uppercase tracking-wide">Rencana Studi (KRS)</h2>
                  </div>
                  <KrsAccordion currentKrs={currentKrsData} pastKrs={pastKrsData} client:load />
                </div>

                <!-- Billing status -->
                <div class="lg:col-span-1 space-y-4">
                  <div class="border-b border-zinc-200 pb-3">
                    <h2 class="text-sm font-bold text-zinc-900 uppercase tracking-wide">Keuangan & Tagihan</h2>
                  </div>
                  {billingData ? (
                    <Card className="shadow-sm border border-zinc-200 bg-white">
                      <CardHeader className="border-b border-zinc-150 p-4 bg-zinc-50/50">
                        <div class="flex justify-between items-start gap-2">
                          <div>
                            <CardTitle className="text-xs font-bold text-zinc-900 uppercase tracking-wide">
                              {billingData.status.includes("TERBAYAR") ? "Detail Pembayaran" : "Detail Tagihan"}
                            </CardTitle>
                            <CardDescription className="text-[10px] text-zinc-500 mt-1 leading-snug">{billingData.informasi}</CardDescription>
                          </div>
                          <Badge 
                            variant={billingData.status.includes("TERBAYAR") ? "default" : "outline"} 
                            className={`text-[9px] uppercase px-1.5 py-0.5 border-zinc-300 ${billingData.status.includes("TERBAYAR") ? "bg-zinc-900 text-zinc-50" : "text-zinc-650 bg-zinc-50"}`}
                          >
                            {billingData.status.includes("TERBAYAR") ? "Lunas" : "Tagihan"}
                          </Badge>
                        </div>
                      </CardHeader>
                      <CardContent className="p-4 space-y-4">
                        <div>
                          <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider">
                            {billingData.status.includes("TERBAYAR") ? "Jumlah Terbayar" : "Jumlah Pembayaran"}
                          </span>
                          <span class="text-lg font-black text-zinc-950 tracking-tight block mt-1">{formatRupiah(billingData.total_tagih)}</span>
                        </div>

                        <div class="border-t border-zinc-150 pt-3 space-y-2 text-xs">
                          <div class="flex justify-between">
                            <span class="text-zinc-500">Tahun Ajaran</span>
                            <span class="font-medium text-zinc-800">{billingData.tahun_ajaran}</span>
                          </div>
                          <div class="flex justify-between">
                            <span class="text-zinc-500">Status</span>
                            <span class="font-medium text-zinc-800">{billingData.status_pembayaran}</span>
                          </div>
                          <div class="flex justify-between">
                            <span class="text-zinc-500">Metode</span>
                            <span class="font-medium text-zinc-800">{billingData.via || '-'}</span>
                          </div>
                          <div class="flex justify-between">
                            <span class="text-zinc-500">Tanggal</span>
                            <span class="font-mono text-zinc-650">{billingData.tanggal ? billingData.tanggal.split(' ')[0] : '-'}</span>
                          </div>
                        </div>
                      </CardContent>
                    </Card>
                  ) : (
                    <Card className="shadow-sm border border-zinc-200 bg-white p-5 text-center">
                      <span class="text-zinc-500 text-xs font-medium">Data tagihan tidak tersedia.</span>
                    </Card>
                  )}
                </div>
              </div>

              <!-- Transcript Listing component -->
              <TranscriptView transcript={transcriptData} khsHeader={khsHeaderData} client:load />
            </>
          ) : (
            <Card className="shadow-sm border border-zinc-200 bg-white p-12 text-center flex flex-col items-center justify-center">
              <div class="w-12 h-12 rounded-full bg-zinc-50 border border-zinc-200 flex items-center justify-center text-zinc-400 mb-3">
                🔍
              </div>
              <h3 class="text-sm font-bold text-zinc-900">Pilih Mahasiswa</h3>
              <p class="text-xs text-zinc-500 mt-1 max-w-xs">Silakan pilih mahasiswa dari daftar di sebelah kiri untuk memantau performa akademis, visualisasi anatomi risiko, KRS, serta transkrip nilai mereka.</p>
            </Card>
          )}
        </div>
      </div>
    </main>
  </div>

  <!-- Send Email Modal (HTML <dialog> with modern Tailwind CSS styling) -->
  <dialog id="email-modal" class="p-0 rounded-xl border border-zinc-200 bg-white shadow-2xl backdrop:bg-zinc-950/40 backdrop:backdrop-blur-md max-w-lg w-full overflow-hidden transition-all duration-300 ease-in-out opacity-0 translate-y-4 open:opacity-100 open:translate-y-0">
    <div class="flex flex-col h-full">
      <!-- Header -->
      <div class="px-6 py-4 bg-zinc-50 border-b border-zinc-150 flex justify-between items-center">
        <div>
          <h3 class="text-xs font-bold text-zinc-900 uppercase tracking-wider">Kirim Email ke Mahasiswa</h3>
          <p class="text-[10px] text-zinc-500 mt-0.5 font-medium">Kirim notifikasi atau bimbingan akademik menggunakan SMTP server.</p>
        </div>
        <button id="btn-close-email-modal" class="text-zinc-400 hover:text-zinc-700 p-1.5 rounded-lg hover:bg-zinc-100 transition-all cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Form Content -->
      <form id="email-form" class="p-6 space-y-4">
        <!-- Sender info -->
        <div>
          <label class="block text-[9px] font-bold text-zinc-450 uppercase tracking-wider mb-1">Pengirim (Admin)</label>
          <input 
            type="text" 
            value={adminInfo ? `${adminInfo.name} (${adminInfo.username})` : 'Admin'} 
            readonly 
            class="w-full text-xs px-3 py-2 bg-zinc-50 border border-zinc-200 rounded text-zinc-500 focus:outline-none cursor-not-allowed font-medium" 
          />
        </div>

        <!-- Recipient info -->
        <div>
          <label class="block text-[9px] font-bold text-zinc-450 uppercase tracking-wider mb-1">Penerima (Mahasiswa)</label>
          <input 
            type="email" 
            id="recipient-email"
            value={selectedStudent ? selectedStudent.email : ''}
            readonly 
            class="w-full text-xs px-3 py-2 bg-zinc-50 border border-zinc-200 rounded text-zinc-500 focus:outline-none cursor-not-allowed font-mono font-medium" 
          />
        </div>

        <!-- Subject -->
        <div>
          <label for="email-subject" class="block text-[9px] font-bold text-zinc-450 uppercase tracking-wider mb-1">Subjek Email</label>
          <input 
            type="text" 
            id="email-subject" 
            required 
            placeholder="Masukkan subjek email..." 
            class="w-full text-xs px-3 py-2 border border-zinc-200 rounded text-zinc-900 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-950 focus:border-zinc-950 transition-all font-medium"
          />
        </div>

        <!-- Message -->
        <div>
          <label for="email-message" class="block text-[9px] font-bold text-zinc-450 uppercase tracking-wider mb-1">Pesan / Konten</label>
          <textarea 
            id="email-message" 
            required 
            rows="5" 
            placeholder="Tulis pesan akademik di sini..." 
            class="w-full text-xs px-3 py-2 border border-zinc-200 rounded text-zinc-900 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-950 focus:border-zinc-950 transition-all resize-none font-medium"
          ></textarea>
        </div>

        <!-- Status / Message box -->
        <div id="email-status-message" class="hidden text-[11px] p-2.5 rounded border font-medium"></div>

        <!-- Footer Actions -->
        <div class="flex justify-end gap-3 pt-4 border-t border-zinc-100">
          <button 
            type="button" 
            id="btn-cancel-email" 
            class="px-4 py-2 border border-zinc-250 text-xs font-semibold text-zinc-650 hover:bg-zinc-50 rounded transition-all cursor-pointer"
          >
            Batal
          </button>
          <button 
            type="submit" 
            id="btn-send-email-submit" 
            class="px-4 py-2 bg-zinc-950 text-xs font-semibold text-white hover:bg-zinc-800 rounded shadow-sm transition-all flex items-center gap-1.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="btn-text">Kirim Email</span>
            <span id="btn-spinner" class="hidden w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    // Client-side dialog controller
    const openBtn = document.getElementById('btn-open-email-modal');
    const closeBtn = document.getElementById('btn-close-email-modal');
    const cancelBtn = document.getElementById('btn-cancel-email');
    const modal = document.getElementById('email-modal') as HTMLDialogElement | null;
    const form = document.getElementById('email-form') as HTMLFormElement | null;
    const statusMsg = document.getElementById('email-status-message');
    const btnSubmit = document.getElementById('btn-send-email-submit') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    if (openBtn && modal) {
      openBtn.addEventListener('click', () => {
        // Clear previous input values and status message
        if (form) {
          const subjectInput = document.getElementById('email-subject') as HTMLInputElement | null;
          const messageInput = document.getElementById('email-message') as HTMLTextAreaElement | null;
          if (subjectInput) subjectInput.value = '';
          if (messageInput) messageInput.value = '';
        }
        if (statusMsg) {
          statusMsg.classList.add('hidden');
          statusMsg.textContent = '';
        }
        modal.showModal();
        modal.classList.remove('opacity-0', 'translate-y-4');
      });
    }

    const closeModal = () => {
      if (modal) {
        modal.classList.add('opacity-0', 'translate-y-4');
        // Wait for CSS transitions to finish before closing
        setTimeout(() => {
          modal.close();
        }, 150);
      }
    };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    // Close on clicking backdrop
    if (modal) {
      modal.addEventListener('click', (e) => {
        const dialogDimensions = modal.getBoundingClientRect();
        if (
          e.clientX < dialogDimensions.left ||
          e.clientX > dialogDimensions.right ||
          e.clientY < dialogDimensions.top ||
          e.clientY > dialogDimensions.bottom
        ) {
          closeModal();
        }
      });
    }

    // Submit handler
    if (form && btnSubmit && btnText && btnSpinner && statusMsg) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const recipientInput = document.getElementById('recipient-email') as HTMLInputElement | null;
        const subjectInput = document.getElementById('email-subject') as HTMLInputElement | null;
        const messageInput = document.getElementById('email-message') as HTMLTextAreaElement | null;

        const recipient = recipientInput?.value;
        const subject = subjectInput?.value;
        const message = messageInput?.value;

        if (!recipient || !subject || !message) {
          statusMsg.className = 'text-[11px] p-2.5 rounded border border-red-200 bg-red-50 text-red-700 font-medium';
          statusMsg.textContent = 'Semua field wajib diisi.';
          statusMsg.classList.remove('hidden');
          return;
        }

        // Set UI loading state
        btnSubmit.disabled = true;
        btnText.textContent = 'Mengirim...';
        btnSpinner.classList.remove('hidden');
        statusMsg.classList.add('hidden');

        try {
          const res = await fetch('/api/send-email', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ to: recipient, subject, message })
          });

          const data = await res.json();

          if (res.ok && data.success) {
            statusMsg.className = 'text-[11px] p-2.5 rounded border border-zinc-200 bg-zinc-50 text-zinc-900 font-semibold';
            statusMsg.textContent = 'Email berhasil dikirim ke mahasiswa!';
            statusMsg.classList.remove('hidden');

            setTimeout(() => {
              closeModal();
            }, 1800);
          } else {
            statusMsg.className = 'text-[11px] p-2.5 rounded border border-red-200 bg-red-50 text-red-700 font-medium';
            statusMsg.textContent = data.error || 'Terjadi kesalahan saat mengirim email.';
            statusMsg.classList.remove('hidden');
          }
        } catch (err) {
          console.error(err);
          statusMsg.className = 'text-[11px] p-2.5 rounded border border-red-200 bg-red-50 text-red-700 font-medium';
          statusMsg.textContent = 'Gagal terhubung ke server.';
          statusMsg.classList.remove('hidden');
        } finally {
          // Reset UI state
          btnSubmit.disabled = false;
          btnText.textContent = 'Kirim Email';
          btnSpinner.classList.add('hidden');
        }
      });
    }
  </script>
</Layout>
