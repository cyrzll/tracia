---
import Layout from '../../../layouts/Layout.astro';
import { validateAdminSession, clearAdminSession } from '../../../utils/auth';
import { StudentList } from '@/components/StudentList';
import { StudentDetailsPanel } from '@/components/StudentDetailsPanel';
import { Button } from '@/components/ui/button';
import { LanguageSelector } from '../../../components/navbar/LanguageSelector';
import { db } from '../../../lib/db';
import { Mhs, MhsKrs, MhsTranscript, MhsBilling } from '../../../lib/schema';
import { eq } from 'drizzle-orm';

// Helper to map route parameter to database NIM prefix
const prodiToPrefix = (p: string) => {
  const upper = p.toUpperCase();
  if (upper === 'TI') return 'F11';
  if (upper === 'SI') return 'F12';
  if (upper === 'MANAJEMEN') return 'F13';
  if (upper === 'DKV') return 'F14';
  return upper;
};

const prefixToProdi = (prefix: string) => {
  if (prefix === 'F11') return 'TI';
  if (prefix === 'F12') return 'SI';
  if (prefix === 'F13') return 'MANAJEMEN';
  if (prefix === 'F14') return 'DKV';
  return prefix;
};

// 1. Authentication Check
const { isLoggedIn, adminInfo } = await validateAdminSession(Astro.cookies);
if (!isLoggedIn || !adminInfo) {
  return Astro.redirect('/login');
}

// 2. Authorization Check
// Redirect Super Admin back to the admin dashboard
if (adminInfo.level === 'admin') {
  return Astro.redirect('/dash/admin');
}

// Redirect lecturers trying to access a department they don't manage
const { prodi } = Astro.params;
const expectedPrefix = prodiToPrefix(prodi || '');

if (adminInfo.level.startsWith('lecturer-')) {
  const lecturerPrefix = adminInfo.level.split('-')[1];
  if (lecturerPrefix !== expectedPrefix) {
    const expectedProdiName = prefixToProdi(lecturerPrefix);
    return Astro.redirect(`/dash/lecturer/${expectedProdiName}`);
  }
} else {
  // Catch-all: if they have any other non-lecturer level, send to login
  return Astro.redirect('/login');
}

// 3. Handle Logout
if (Astro.url.searchParams.get('action') === 'logout') {
  clearAdminSession(Astro.cookies);
  return Astro.redirect('/login');
}

// 4. Fetch Students belonging to this specific department
const allStudents = await db.select().from(Mhs);
const dbStudents = allStudents.filter(s => s.nim.startsWith(expectedPrefix));

// 5. Get Selected Student NIM from Query Parameters
let selectedNim = Astro.url.searchParams.get('nim');
if (selectedNim && !selectedNim.startsWith(expectedPrefix)) {
  // Reset selected student if they are outside this department
  selectedNim = null;
}
if (!selectedNim && dbStudents.length > 0) {
  selectedNim = dbStudents[0].nim;
}

// 6. Fetch details for selected student
let selectedStudent = null;
let currentKrsData = null;
let pastKrsData = null;
let billingData = null;
let transcriptData = null;
let khsHeaderData = null;

// Health metrics
let isBrainHealthy = true;
let isHeartHealthy = true;
let isHandsHealthy = true;
let isFeetHealthy = true;
let velocity = 0.0;

if (selectedNim) {
  const found = dbStudents.find(s => s.nim === selectedNim);
  if (found) {
    selectedStudent = found;

    const [dbKrs, dbTranscript, dbBilling] = await Promise.all([
      db.select().from(MhsKrs).where(eq(MhsKrs.nim, selectedNim)),
      db.select().from(MhsTranscript).where(eq(MhsTranscript.nim, selectedNim)),
      db.select().from(MhsBilling).where(eq(MhsBilling.nim, selectedNim)).limit(1)
    ]);

    const krsMap = new Map<string, any[]>();
    dbKrs.forEach(row => {
      if (!krsMap.has(row.ta)) {
        krsMap.set(row.ta, []);
      }
      krsMap.get(row.ta)!.push({
        kdmk: row.kdmk,
        nmmk: row.nmmk,
        klpk: row.klpk,
        sks: row.sks,
        sts: row.status
      });
    });

    const pastKrsList: any[] = [];
    const sortedTas = Array.from(krsMap.keys()).sort();
    sortedTas.forEach((ta, idx) => {
      const isLast = idx === sortedTas.length - 1;
      const semKrs = {
        ta: ta,
        kode_ta: ta,
        krs: krsMap.get(ta)!
      };
      if (isLast) {
        currentKrsData = semKrs;
      } else {
        pastKrsList.push(semKrs);
      }
    });
    pastKrsData = pastKrsList;

    transcriptData = dbTranscript.map(row => ({
      kdmk: row.kdmk,
      nmmk: row.nmmk,
      sks: row.sks,
      nl: row.nilai
    }));

    const totalSks = transcriptData.reduce((sum, item) => sum + Number(item.sks), 0);
    const gradeCounts = new Map<string, number>();
    transcriptData.forEach(item => {
      gradeCounts.set(item.nl, (gradeCounts.get(item.nl) || 0) + 1);
    });
    const total_nilai = Array.from(gradeCounts.entries()).map(([nilai, jumlah]) => ({
      nilai,
      jumlah
    }));

    khsHeaderData = {
      total_sks: totalSks,
      ipk: selectedStudent.gpa,
      total_nilai
    };

    if (dbBilling.length > 0) {
      const b = dbBilling[0];
      billingData = {
        status: b.status,
        total_tagih: b.totalTagih,
        informasi: b.informasi,
        tahun_ajaran: b.ta,
        status_pembayaran: b.status.includes("TERBAYAR") ? "PAID" : "UNPAID",
        via: b.via,
        tanggal: b.tanggal,
        SKS_sekarang: 0,
        SPP_sekarang: 0,
        GDG_sekarang: 0,
        MOD_sekarang: 0,
        BK_sekarang: 0,
        POLI_sekarang: 0
      };
    }

    isBrainHealthy = selectedStudent.gpa >= 3.0;
    isHeartHealthy = !!(billingData && billingData.status.includes("TERBAYAR"));
    isHandsHealthy = transcriptData.filter(c => c.nl === 'D' || c.nl === 'E').length === 0;
    velocity = selectedStudent.semester > 1 ? selectedStudent.sks / (selectedStudent.semester - 1) : selectedStudent.sks;
    isFeetHealthy = velocity >= 12;
  }
}
---

<Layout 
  title={`Lecturer Portal - ${prodi?.toUpperCase()} | TRACIA AI`}
  description={`TRACIA AI student monitoring dashboard for Lecturer of ${prodi?.toUpperCase()} Department.`}
>
  <style is:global>
    html, body {
      background-color: #000000 !important;
    }
  </style>

  <div class="min-h-screen text-white font-sans relative z-10">
    <!-- Navbar (Dark Glassmorphic) -->
    <nav class="border-b border-zinc-800/80 bg-zinc-950/40 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-full w-full mx-auto px-4 sm:px-8 lg:px-12">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-2">
            <img src="/favicon.ico" alt="TRACIA AI" class="w-6 h-6 object-contain" />
            <span class="font-bold text-sm tracking-wider text-white">TRACIA AI</span>
          </div>

          <div class="flex items-center gap-4">
            <!-- Lecturer Profile Display -->
            <div class="flex flex-col items-end text-right">
              <span class="text-xs font-semibold text-white">{adminInfo.name}</span>
              <span class="text-[9px] uppercase font-bold text-zinc-500 tracking-wider">Kaprodi {prodi?.toUpperCase()}</span>
            </div>
            <div class="w-8 h-8 rounded-xl border border-zinc-800 bg-zinc-900 flex items-center justify-center">
              <span class="text-xs font-bold text-zinc-300">LC</span>
            </div>
            
            <div class="border-l border-zinc-800 h-5 mx-1"></div>
            
            <LanguageSelector client:load />
            
            <div class="border-l border-zinc-800 h-5 mx-1"></div>

            <!-- Logout Button -->
            <Button
              variant="outline"
              size="sm"
              className="h-8 text-[11px] gap-1 px-3 py-1 bg-zinc-900 text-zinc-400 border-zinc-800 hover:bg-zinc-800 hover:text-white rounded-xl"
              asChild
            >
              <a href="?action=logout" class="flex items-center gap-1.5 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                </svg>
                Logout
              </a>
            </Button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content Area -->
    <main class="max-w-full w-full mx-auto px-4 sm:px-8 lg:px-12 py-8">
      <!-- Welcome Header -->
      <div class="mb-8 border-b border-zinc-800/80 pb-6">
        <h1 class="text-2xl font-bold text-white tracking-tight">STUDENT RISK MONITORING &bull; KAPRODI {prodi?.toUpperCase()}</h1>
        <p class="text-xs text-zinc-500 mt-1">Real-time dropout predictions and active interventions &bull; Faculty Head: {adminInfo.name}</p>
      </div>

      <!-- Main Layout Grid: Left list, Right details -->
      <div class="grid grid-cols-1 xl:grid-cols-3 gap-8 items-start">
        
        <!-- Left Side: Student List (1 column on XL, full width otherwise) -->
        <div class="xl:col-span-1 space-y-6 xl:sticky xl:top-24">
          <StudentList students={dbStudents} initialSelectedNim={selectedNim} client:load />

          <!-- System Insight Card -->
          <div class="border border-zinc-800 bg-zinc-950/40 backdrop-blur-md rounded-2xl p-4 shadow-sm">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider">Department Scope</h3>
            <p class="text-xs text-zinc-550 leading-relaxed mt-2">
              You are currently viewing data filtered specifically for the {prodi?.toUpperCase()} Study Program. You only have clearance to inspect and nudge students within this department scope.
            </p>
          </div>
        </div>

        <!-- Right Side: Detailed View (2 columns on XL, full width otherwise) -->
        <div class="xl:col-span-2 space-y-8">
          <StudentDetailsPanel
            initialStudent={selectedStudent}
            students={dbStudents}
            initialKrs={currentKrsData}
            initialPastKrs={pastKrsData}
            initialBilling={billingData}
            initialTranscript={transcriptData}
            initialKhsHeader={khsHeaderData}
            initialIsBrainHealthy={isBrainHealthy}
            initialIsHeartHealthy={isHeartHealthy}
            initialIsHandsHealthy={isHandsHealthy}
            initialIsFeetHealthy={isFeetHealthy}
            initialVelocity={velocity}
            adminName={adminInfo.name}
            adminUsername={adminInfo.username}
            adminLevel={adminInfo.level}
            client:load
          />
        </div>
      </div>
    </main>
  </div>
</Layout>
