---
import Layout from '../../../layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { KrsAccordion } from '@/components/KrsAccordion';
import { TranscriptView } from '@/components/TranscriptView';
import { db } from '../../../lib/db';
import { Mhs, MhsKrs, MhsTranscript, MhsBilling } from '../../../lib/schema';
import { eq } from 'drizzle-orm';



// 1. Check Student Session Cookie
const mhsToken = Astro.cookies.get('mhs_access_token');
if (!mhsToken) {
  return Astro.redirect('/login');
}

// 2. Handle Logout
if (Astro.url.searchParams.get('action') === 'logout') {
  Astro.cookies.delete('mhs_access_token', { path: '/' });
  return Astro.redirect('/login');
}

// 3. Fetch SIADIN Mini Profile, KRS, Billing, & Transcript Data
let studentData = null;
let currentKrsData = null;
let pastKrsData = null;
let billingData = null;
let khsHeaderData = null;
let transcriptData = null;
let predictionData = null;
let fetchError = '';

// Health state variables for visual metaphor
let isBrainHealthy = true;
let isHeartHealthy = true;
let isHandsHealthy = true;
let isFeetHealthy = true;
let velocity = 0.0;

const getGradeWeight = (grade: string) => {
  switch (grade.toUpperCase()) {
    case 'A': return 4.0;
    case 'AB': return 3.5;
    case 'B': return 3.0;
    case 'BC': return 2.5;
    case 'C': return 2.0;
    case 'D': return 1.0;
    case 'E': return 0.0;
    default: return 0.0;
  }
};

const gradeToScore = (grade: string) => {
  switch (grade.toUpperCase()) {
    case 'A': return 90;
    case 'AB': return 80;
    case 'B': return 72;
    case 'BC': return 65;
    case 'C': return 58;
    case 'D': return 50;
    case 'E': return 30;
    default: return 75;
  }
};

const formatRupiah = (value: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(value);
};

try {
  const response = await fetch('https://api.dinus.ac.id/api/v1/siadin/get-mini-profile', {
    method: 'GET',
    headers: {
      'Authorization': `Bearer ${mhsToken.value}`,
      'Accept': 'application/json'
    }
  });

  if (response.ok) {
    const result = await response.json();
    if (result && result.code === 200 && result.data) {
      studentData = result.data;

      // Fetch KRS, Billing, and KHS academic data in parallel
      try {
        const [currentKrsRes, pastKrsRes, billingRes, khsHeaderRes, transcriptRes] = await Promise.all([
          fetch('https://api.dinus.ac.id/api/v1/siadin/get-krs', {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${mhsToken.value}`,
              'Accept': 'application/json'
            }
          }),
          fetch('https://api.dinus.ac.id/api/v1/siadin/get-krs-lalu', {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${mhsToken.value}`,
              'Accept': 'application/json'
            }
          }),
          fetch('https://api.dinus.ac.id/api/v1/siadin/get-tagihan', {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${mhsToken.value}`,
              'Accept': 'application/json'
            }
          }),
          fetch('https://api.dinus.ac.id/api/v1/siadin/header-khs', {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${mhsToken.value}`,
              'Accept': 'application/json'
            }
          }),
          fetch('https://api.dinus.ac.id/api/v1/siadin/get-transkrip', {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${mhsToken.value}`,
              'Accept': 'application/json'
            }
          })
        ]);

        if (currentKrsRes.ok) {
          const currentKrsJson = await currentKrsRes.json();
          if (currentKrsJson && currentKrsJson.code === 200 && currentKrsJson.data) {
            currentKrsData = currentKrsJson.data;
          }
        }

        if (pastKrsRes.ok) {
          const pastKrsJson = await pastKrsRes.json();
          if (pastKrsJson && pastKrsJson.code === 200 && pastKrsJson.data) {
            pastKrsData = pastKrsJson.data;
          }
        }

        if (billingRes.ok) {
          const billingJson = await billingRes.json();
          if (billingJson && billingJson.code === 200 && billingJson.data) {
            billingData = billingJson.data;
          }
        }

        if (khsHeaderRes.ok) {
          const khsHeaderJson = await khsHeaderRes.json();
          if (khsHeaderJson && khsHeaderJson.code === 200 && khsHeaderJson.data) {
            khsHeaderData = khsHeaderJson.data;
          }
        }

        if (transcriptRes.ok) {
          const transcriptJson = await transcriptRes.json();
          if (transcriptJson && transcriptJson.code === 200 && transcriptJson.data) {
            transcriptData = transcriptJson.data;
          }
        }

        // Fetch prediction from ML API
        if (khsHeaderData && transcriptData) {
          try {
            const activeSemester = (currentKrsData ? 1 : 0) + (pastKrsData ? pastKrsData.length : 0);

            const courseGrades = new Map();
            transcriptData.forEach(c => {
              courseGrades.set(c.kdmk, c.nl);
            });

            const semesterGpas = [];
            if (pastKrsData) {
              const sortedPast = [...pastKrsData].sort((a, b) => a.kode_ta.localeCompare(b.kode_ta));
              sortedPast.forEach(sem => {
                let totalSks = 0;
                let totalPoints = 0;
                sem.krs.forEach(c => {
                  const grade = courseGrades.get(c.kdmk);
                  if (grade) {
                    totalSks += c.sks;
                    totalPoints += getGradeWeight(grade) * c.sks;
                  }
                });
                if (totalSks > 0) {
                  semesterGpas.push(totalPoints / totalSks);
                }
              });
            }

            let gpaTrend = 0.0;
            if (semesterGpas.length >= 2) {
              gpaTrend = semesterGpas[semesterGpas.length - 1] - semesterGpas[semesterGpas.length - 2];
            }

            const scores = transcriptData.map(c => gradeToScore(c.nl));
            const averageScore = scores.length > 0 ? scores.reduce((a, b) => a + b, 0) / scores.length : 75;
            const highestScore = scores.length > 0 ? Math.max(...scores) : 75;
            const lowestScore = scores.length > 0 ? Math.min(...scores) : 75;

            let scoreStd = 0.0;
            if (scores.length > 1) {
              const mean = averageScore;
              const variance = scores.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / scores.length;
              scoreStd = Math.sqrt(variance);
            }

            const failedCourses = transcriptData.filter(c => c.nl === 'D' || c.nl === 'E').length;
            const totalCredits = khsHeaderData.total_sks;
            const paymentStatus = billingData && billingData.status.includes("TERBAYAR") ? "Paid" : "Unpaid";
            velocity = activeSemester > 1 ? totalCredits / (activeSemester - 1) : totalCredits;

            // Set visual metaphor health indicators
            isBrainHealthy = khsHeaderData.ipk >= 3.0;
            isHeartHealthy = paymentStatus === "Paid";
            isHandsHealthy = failedCourses === 0;
            isFeetHealthy = velocity >= 12;

            const payload = {
              "Semester": activeSemester,
              "Current_GPA": khsHeaderData.ipk,
              "GPA_Trend": Number(gpaTrend.toFixed(4)),
              "Attendance_Rate": 0.95,
              "Credit_Accumulation_Velocity": Number(velocity.toFixed(2)),
              "Failed_Course_Count": failedCourses,
              "Total_Credits_Completed": totalCredits,
              "Payment_Status": paymentStatus,
              "Average_Final_Score": Number(averageScore.toFixed(2)),
              "Highest_Final_Score": highestScore,
              "Lowest_Final_Score": lowestScore,
              "Final_Score_Std": Number(scoreStd.toFixed(4))
            };

            const predictRes = await fetch("http://127.0.0.1:4322/predict", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify(payload)
            });

            if (predictRes.ok) {
              predictionData = await predictRes.json();

              // Save or update student in Astro DB
              try {
                const nimStr = studentData.nim;
                const mhsValues = {
                  nim: nimStr,
                  nama: studentData.nama,
                  email: studentData.email_mhs,
                  gender: studentData.gender,
                  foto: studentData.foto,
                  gpa: khsHeaderData.ipk,
                  sks: khsHeaderData.total_sks,
                  semester: activeSemester,
                  risk_probability: predictionData.dropout_risk_probability,
                  risk_level: predictionData.risk_level,
                  updatedAt: new Date()
                };

                const existing = await db.select().from(Mhs).where(eq(Mhs.nim, nimStr)).limit(1);
                if (existing.length > 0) {
                  await db.update(Mhs).set(mhsValues).where(eq(Mhs.nim, nimStr));
                } else {
                  await db.insert(Mhs).values(mhsValues);
                }

                // 2. Clear and Save MhsKrs
                await db.delete(MhsKrs).where(eq(MhsKrs.nim, nimStr));
                const krsRows = [];
                if (currentKrsData && currentKrsData.krs) {
                  currentKrsData.krs.forEach((course: any) => {
                    krsRows.push({
                      nim: nimStr,
                      ta: currentKrsData.ta,
                      kdmk: course.kdmk,
                      nmmk: course.nmmk,
                      klpk: course.klpk,
                      sks: Number(course.sks),
                      status: course.sts,
                    });
                  });
                }
                if (pastKrsData) {
                  pastKrsData.forEach((sem: any) => {
                    if (sem.krs) {
                      sem.krs.forEach((course: any) => {
                        krsRows.push({
                          nim: nimStr,
                          ta: sem.ta,
                          kdmk: course.kdmk,
                          nmmk: course.nmmk,
                          klpk: course.klpk,
                          sks: Number(course.sks),
                          status: course.sts || 'LALU',
                        });
                      });
                    }
                  });
                }
                if (krsRows.length > 0) {
                  await db.insert(MhsKrs).values(krsRows);
                }

                // 3. Clear and Save MhsTranscript
                await db.delete(MhsTranscript).where(eq(MhsTranscript.nim, nimStr));
                const transcriptRows = [];
                if (transcriptData) {
                  transcriptData.forEach((course: any) => {
                    transcriptRows.push({
                      nim: nimStr,
                      kdmk: course.kdmk,
                      nmmk: course.nmmk,
                      sks: Number(course.sks),
                      nilai: course.nl,
                    });
                  });
                }
                if (transcriptRows.length > 0) {
                  await db.insert(MhsTranscript).values(transcriptRows);
                }

                // 4. Upsert MhsBilling
                if (billingData) {
                  const billingValues = {
                    nim: nimStr,
                    ta: billingData.tahun_ajaran,
                    status: billingData.status,
                    totalTagih: Number(billingData.total_tagih),
                    informasi: billingData.informasi,
                    via: billingData.via || '',
                    tanggal: billingData.tanggal || '',
                  };
                  const existingBilling = await db.select().from(MhsBilling).where(eq(MhsBilling.nim, nimStr)).limit(1);
                  if (existingBilling.length > 0) {
                    await db.update(MhsBilling).set(billingValues).where(eq(MhsBilling.nim, nimStr));
                  } else {
                    await db.insert(MhsBilling).values(billingValues);
                  }
                }
              } catch (dbErr) {
                console.error('Error saving student details to Astro DB:', dbErr);
              }
            }


          } catch (predictErr) {
            console.error('Prediction fetch error:', predictErr);
          }
        }
      } catch (krsErr) {
        console.error('KRS/Billing/KHS fetch error:', krsErr);
      }
    } else {
      fetchError = result.message || 'Gagal memuat profil mahasiswa.';
    }
  } else {
    // If token is invalid or expired, redirect to login
    Astro.cookies.delete('mhs_access_token', { path: '/' });
    return Astro.redirect('/login');
  }
} catch (error) {
  fetchError = 'Koneksi ke server SIADIN terputus.';
  console.error('SIADIN Profile fetch error:', error);
}
---

<Layout title="Dashboard Mahasiswa | Student Risk Predictor">
  <div class="min-h-screen bg-zinc-50 text-zinc-800 font-sans">
    <!-- Navbar -->
    <nav class="border-b border-zinc-200 bg-white/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 border-2 border-zinc-900 flex items-center justify-center bg-zinc-900">
              <span class="text-white font-black text-xs">T</span>
            </div>
            <span class="font-bold text-sm tracking-wider text-zinc-900">TRACIA AI</span>
          </div>

          <div class="flex items-center gap-4">
            {studentData && (
              <div class="flex items-center gap-3">
                <div class="hidden sm:flex flex-col items-end text-right">
                  <span class="text-xs font-semibold text-zinc-900">{studentData.nama}</span>
                  <span class="text-[9px] uppercase font-bold text-zinc-500 tracking-wider">MAHASISWA</span>
                </div>
                <img 
                  src={studentData.foto} 
                  alt={studentData.nama} 
                  class="w-8 h-8 rounded border border-zinc-200 object-cover bg-zinc-100 grayscale hover:grayscale-0 transition-all duration-300"
                />
              </div>
            )}
            
            <div class="border-l border-zinc-200 h-5 mx-1"></div>
            
            <!-- Logout Button -->
            <Button
              variant="outline"
              size="sm"
              className="h-8 text-[11px] gap-1 px-3 py-1 bg-white text-zinc-650 border-zinc-200 hover:bg-zinc-50 hover:text-zinc-900"
              asChild
            >
              <a href="?action=logout" class="flex items-center gap-1.5 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                </svg>
                Logout
              </a>
            </Button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content Area -->
    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <!-- Welcome Header -->
      <div class="mb-8 border-b border-zinc-200 pb-6">
        <h1 class="text-2xl font-bold text-zinc-900 tracking-tight">PORTAL MAHASISWA</h1>
        <p class="text-xs text-zinc-500 mt-1">Sistem Pemantauan Akademis Terintegrasi SIADIN Universitas Dian Nuswantoro</p>
      </div>

      {fetchError ? (
        <div class="p-4 border border-zinc-200 bg-white rounded shadow-sm flex items-start gap-3">
          <span class="text-zinc-900 font-bold">[!]</span>
          <div>
            <h3 class="text-sm font-bold text-zinc-900">Terjadi Kesalahan</h3>
            <p class="text-xs text-zinc-500 mt-0.5">{fetchError}</p>
            <Button size="sm" className="mt-3" asChild>
              <a href="?action=logout">Kembali Ke Login</a>
            </Button>
          </div>
        </div>
      ) : studentData && (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Profile Picture Card (Left) -->
          <div class="md:col-span-1">
            <Card className="shadow-sm border border-zinc-200 bg-white overflow-hidden text-center p-6 flex flex-col items-center">
              <div class="w-32 h-32 rounded border border-zinc-200 overflow-hidden bg-zinc-50 mb-4 relative shadow-inner">
                <img 
                  src={studentData.foto} 
                  alt={studentData.nama} 
                  class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-300"
                />
              </div>
              <h2 class="text-sm font-bold text-zinc-900 uppercase tracking-wide leading-snug">{studentData.nama}</h2>
              <p class="text-xs text-zinc-500 font-mono mt-1">{studentData.nim}</p>
            </Card>
          </div>

          <!-- Profile Details Card (Right) -->
          <div class="md:col-span-2">
            <Card className="shadow-sm border border-zinc-200 bg-white">
              <CardHeader className="border-b border-zinc-150 p-5 bg-zinc-50/50">
                <CardTitle className="text-sm font-bold text-zinc-900 uppercase tracking-wide">Informasi Mahasiswa</CardTitle>
                <CardDescription className="text-zinc-500">Detail data diri mahasiswa yang tercatat pada sistem akademik SIADIN.</CardDescription>
              </CardHeader>
              <CardContent className="p-6 space-y-6">
                <!-- Grid of Details -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                  <div>
                    <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Nama Lengkap</span>
                    <span class="text-xs font-semibold text-zinc-900 mt-1 block">{studentData.nama}</span>
                  </div>

                  <div>
                    <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">NIM (Nomor Induk Mahasiswa)</span>
                    <span class="text-xs font-mono font-semibold text-zinc-900 mt-1 block">{studentData.nim}</span>
                  </div>

                  <div>
                    <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Email Kampus</span>
                    <span class="text-xs font-mono text-zinc-900 mt-1 block">{studentData.email_mhs}</span>
                  </div>

                  <div>
                    <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Jenis Kelamin</span>
                    <span class="text-xs font-semibold text-zinc-900 mt-1 block">
                      {studentData.gender === 'L' ? 'Laki-laki' : studentData.gender === 'P' ? 'Perempuan' : studentData.gender}
                    </span>
                  </div>
                </div>

                <!-- Info Banner -->
                <div class="border border-zinc-200 bg-zinc-50/40 p-4 rounded text-xs leading-relaxed text-zinc-500">
                  <span class="font-bold text-zinc-700 block mb-1">Catatan Akses Mahasiswa</span>
                  Sebagai mahasiswa, Anda memiliki akses untuk memantau status registrasi dan profil akademik Anda. Untuk analisis risiko dropout tingkat lanjut, silakan hubungi dosen wali atau bagian administrasi akademik.
                </div>
              </CardContent>
            </Card>
          </div>
        </div>

        <!-- Dropout Risk Analysis Card -->
        {predictionData ? (
          <div class="mt-8">
            <Card className="shadow-sm border border-zinc-200 bg-white">
              <CardHeader className="border-b border-zinc-150 p-5 bg-zinc-50/50">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                  <div>
                    <CardTitle className="text-sm font-bold text-zinc-900 uppercase tracking-wide">Analisis Risiko Akademik (AI Dropout Prediction)</CardTitle>
                    <CardDescription className="text-[10px] text-zinc-500 mt-1 leading-snug">Prediksi risiko kegagalan studi mahasiswa secara real-time menggunakan algoritma Machine Learning XGBoost.</CardDescription>
                  </div>
                  <Badge 
                    variant={predictionData.risk_level === "Low" ? "outline" : "default"}
                    className={`text-[9px] px-2 py-0.5 font-bold uppercase border-zinc-300 ${
                      predictionData.risk_level === "Low" 
                        ? "bg-zinc-50 text-zinc-800" 
                        : predictionData.risk_level === "Medium"
                        ? "bg-zinc-850 text-zinc-50"
                        : "bg-zinc-950 text-zinc-50 border-2 border-black"
                    }`}
                  >
                    Risiko {predictionData.risk_level === "Low" ? "Rendah" : predictionData.risk_level === "Medium" ? "Sedang" : "Tinggi"}
                  </Badge>
                </div>
              </CardHeader>
              <CardContent className="p-6">
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-stretch">
                  <!-- Risk Percentage Display (1 col) -->
                  <div class="lg:col-span-1 text-center lg:border-r lg:border-zinc-200 lg:pr-6 flex flex-col justify-center items-center">
                    <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Probabilitas Dropout</span>
                    <span class="text-4xl font-black text-zinc-950 tracking-tighter block mt-2">{(predictionData.dropout_risk_probability * 100).toFixed(2)}%</span>
                    <div class="w-full bg-zinc-100 h-2 rounded-full overflow-hidden mt-4 mx-auto max-w-[200px]">
                      <div 
                        class={`h-full rounded-full transition-all duration-300 ${
                          predictionData.risk_level === "Low" 
                            ? "bg-zinc-400" 
                            : predictionData.risk_level === "Medium" 
                            ? "bg-zinc-700" 
                            : "bg-zinc-950"
                        }`}
                        style={{ width: `${(predictionData.dropout_risk_probability * 100)}%` }}
                      />
                    </div>
                  </div>

                  <!-- Explainability Details & Parameters (2 cols) -->
                  <div class="lg:col-span-2 space-y-4 flex flex-col justify-between">
                    <div>
                      <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">Hasil Analisis Model</span>
                      <p class="text-xs text-zinc-655 mt-1.5 leading-relaxed font-medium">
                        {predictionData.risk_level === "Low" ? (
                          "Performa akademik Anda berada dalam kondisi aman dengan tingkat kestabilan tinggi. Pertahankan nilai IPK Kumulatif Anda dan kecepatan penyelesaian SKS Anda di semester berikutnya."
                        ) : predictionData.risk_level === "Medium" ? (
                          "Model mendeteksi adanya indikator risiko dropout tingkat menengah. Disarankan untuk meninjau kembali tingkat kehadiran kuliah, tren pencapaian IPK, serta memastikan tidak ada pembayaran tagihan yang terlambat."
                        ) : (
                          "PENTING: Model mendeteksi tingkat risiko dropout yang tinggi. Hal ini dipicu oleh tren penurunan IPK yang signifikan, adanya mata kuliah yang tidak lulus, keterlambatan pembayaran biaya kuliah, atau tingkat kehadiran yang rendah. Segera hubungi Dosen Wali Anda."
                        )}
                      </p>
                    </div>

                    <!-- Model input metrics breakdown -->
                    <div class="border-t border-zinc-150 pt-3">
                      <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider mb-2">Parameter Input AI</span>
                      <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-[10px] font-mono text-zinc-500">
                        <div>
                          <span class="text-zinc-400">Semester:</span>
                          <span class="font-bold text-zinc-800 ml-1">{(currentKrsData ? 1 : 0) + (pastKrsData ? pastKrsData.length : 0)}</span>
                        </div>
                        <div>
                          <span class="text-zinc-400">IPK Kumulatif:</span>
                          <span class="font-bold text-zinc-800 ml-1">{khsHeaderData ? khsHeaderData.ipk.toFixed(2) : '0.00'}</span>
                        </div>
                        <div>
                          <span class="text-zinc-400">Kehadiran (Rasio):</span>
                          <span class="font-bold text-zinc-800 ml-1">95.00%</span>
                        </div>
                        <div>
                          <span class="text-zinc-400">Kecepatan SKS:</span>
                          <span class="font-bold text-zinc-800 ml-1">{velocity.toFixed(2)}/sem</span>
                        </div>
                        <div>
                          <span class="text-zinc-400">MK Gagal:</span>
                          <span class="font-bold text-zinc-800 ml-1">{transcriptData ? transcriptData.filter(c => c.nl === 'D' || c.nl === 'E').length : 0}</span>
                        </div>
                        <div>
                          <span class="text-zinc-400">Status Bayar:</span>
                          <span class="font-bold text-zinc-800 ml-1">{billingData && billingData.status.includes("TERBAYAR") ? "Paid" : "Unpaid"}</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Human Body Metaphor Visualization (1 col) -->
                  <div class="lg:col-span-1 flex flex-col items-center justify-center lg:border-l lg:border-zinc-200 lg:pl-6 py-2">
                    <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider mb-3 text-center w-full">Visualisasi Anatomi Risiko</span>
                    
                    <div class="flex items-center gap-4 w-full justify-between">
                      <!-- Stylized SVG Body -->
                      <div class="relative flex-shrink-0">
                        <svg viewBox="0 0 120 220" class="w-16 h-auto text-zinc-900" fill="none" stroke="currentColor" stroke-width="1.5">
                          <!-- Head -->
                          <circle cx="60" cy="30" r="14" class="stroke-zinc-200" />
                          <!-- Spine / Neck -->
                          <line x1="60" y1="44" x2="60" y2="60" class="stroke-zinc-200" />
                          <!-- Torso -->
                          <path d="M 45 60 L 75 60 L 70 120 L 50 120 Z" class="stroke-zinc-200 fill-zinc-50/20" />
                          <!-- Arms -->
                          <path d="M 43 60 C 30 80, 28 100, 32 120" class="stroke-zinc-200" />
                          <path d="M 77 60 C 90 80, 92 100, 88 120" class="stroke-zinc-200" />
                          <!-- Legs -->
                          <path d="M 52 120 L 48 160 L 50 200" class="stroke-zinc-200" />
                          <path d="M 68 120 L 72 160 L 70 200" class="stroke-zinc-200" />
                          
                          <!-- Brain Node (Otak - GPA) -->
                          {isBrainHealthy ? (
                            <circle cx="60" cy="30" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                          ) : (
                            <g>
                              <circle cx="60" cy="30" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                              <circle cx="60" cy="30" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                            </g>
                          )}

                          <!-- Heart Node (Jantung - Financial) -->
                          {isHeartHealthy ? (
                            <circle cx="60" cy="75" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                          ) : (
                            <g>
                              <circle cx="60" cy="75" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                              <circle cx="60" cy="75" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                            </g>
                          )}

                          <!-- Hands Nodes (Tangan - SKS & MK Gagal) -->
                          {isHandsHealthy ? (
                            <>
                              <circle cx="32" cy="120" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                              <circle cx="88" cy="120" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                            </>
                          ) : (
                            <g>
                              <circle cx="32" cy="120" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                              <circle cx="32" cy="120" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                              
                              <circle cx="88" cy="120" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                              <circle cx="88" cy="120" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                            </g>
                          )}

                          <!-- Feet Nodes (Kaki - Kehadiran & SKS Velocity) -->
                          {isFeetHealthy ? (
                            <>
                              <circle cx="50" cy="200" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                              <circle cx="70" cy="200" r="4.5" class="fill-zinc-100 stroke-zinc-400" stroke-width="1.5" />
                            </>
                          ) : (
                            <g>
                              <circle cx="50" cy="200" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                              <circle cx="50" cy="200" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                              
                              <circle cx="70" cy="200" r="7.5" class="fill-zinc-950/15 stroke-zinc-950/25 animate-pulse" stroke-width="1" />
                              <circle cx="70" cy="200" r="3.5" class="fill-zinc-950 stroke-zinc-950" stroke-width="1" />
                            </g>
                          )}
                        </svg>
                      </div>

                      <!-- Bullet Descriptions -->
                      <div class="flex-1 space-y-3 text-[10px] leading-snug">
                        <div class="flex flex-col gap-0.5">
                          <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                            🧠 Otak (GPA)
                            <span class={`w-1.5 h-1.5 rounded-full ${isBrainHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                          </span>
                          <span class="text-zinc-500 font-mono pl-4">{khsHeaderData ? khsHeaderData.ipk.toFixed(2) : '0.00'} IPK</span>
                        </div>
                        <div class="flex flex-col gap-0.5">
                          <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                            ❤️ Jantung (Bayar)
                            <span class={`w-1.5 h-1.5 rounded-full ${isHeartHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                          </span>
                          <span class="text-zinc-500 pl-4">{isHeartHealthy ? "Lunas" : "Tunggakan"}</span>
                        </div>
                        <div class="flex flex-col gap-0.5">
                          <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                            💪 Tangan (SKS)
                            <span class={`w-1.5 h-1.5 rounded-full ${isHandsHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                          </span>
                          <span class="text-zinc-500 pl-4">{khsHeaderData ? khsHeaderData.total_sks : 0} SKS ({transcriptData ? transcriptData.filter(c => c.nl === 'D' || c.nl === 'E').length : 0} MK Gagal)</span>
                        </div>
                        <div class="flex flex-col gap-0.5">
                          <span class="font-bold text-zinc-900 flex items-center gap-1.5">
                            👣 Kaki (Hadir)
                            <span class={`w-1.5 h-1.5 rounded-full ${isFeetHealthy ? 'bg-zinc-400' : 'bg-zinc-950 animate-pulse'}`}></span>
                          </span>
                          <span class="text-zinc-500 font-mono pl-4">95% ({velocity.toFixed(1)}/sem)</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>
        ) : (
          <div class="mt-8">
            <Card className="shadow-sm border border-zinc-200 bg-white p-5 text-center">
              <span class="text-zinc-500 text-xs font-medium">Gagal memuat analisis risiko dari server ML.</span>
            </Card>
          </div>
        )}

        <!-- Academics & Financial Section -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
          <!-- KRS Accordion Section (Left) -->
          <div class="md:col-span-2 space-y-4">
            <div class="border-b border-zinc-200 pb-3">
              <h2 class="text-sm font-bold text-zinc-900 uppercase tracking-wide">Kartu Rencana Studi (KRS)</h2>
              <p class="text-xs text-zinc-500 mt-1">Daftar mata kuliah yang diambil berdasarkan riwayat semester di SIADIN.</p>
            </div>
            <KrsAccordion currentKrs={currentKrsData} pastKrs={pastKrsData} client:load />
          </div>

          <!-- Billing Info Section (Right) -->
          <div class="md:col-span-1 space-y-4">
            <div class="border-b border-zinc-200 pb-3">
              <h2 class="text-sm font-bold text-zinc-900 uppercase tracking-wide">Status Tagihan</h2>
              <p class="text-xs text-zinc-500 mt-1">Informasi status pembayaran registrasi semester Anda.</p>
            </div>

            {billingData ? (
              <Card className="shadow-sm border border-zinc-200 bg-white">
                <CardHeader className="border-b border-zinc-150 p-5 bg-zinc-50/50">
                  <div class="flex justify-between items-start gap-2">
                    <div>
                      <CardTitle className="text-xs font-bold text-zinc-900 uppercase tracking-wide">
                        {billingData.status.includes("TERBAYAR") ? "Detail Pembayaran" : "Detail Tagihan"}
                      </CardTitle>
                      <CardDescription className="text-[10px] text-zinc-500 mt-1 leading-snug">{billingData.informasi}</CardDescription>
                    </div>
                    <Badge 
                      variant={billingData.status.includes("TERBAYAR") ? "default" : "outline"} 
                      className={`text-[9px] uppercase px-1.5 py-0.5 border-zinc-300 ${billingData.status.includes("TERBAYAR") ? "bg-zinc-900 text-zinc-50" : "text-zinc-650 bg-zinc-50"}`}
                    >
                      {billingData.status.includes("TERBAYAR") ? "Lunas" : "Tagihan"}
                    </Badge>
                  </div>
                </CardHeader>
                <CardContent className="p-5 space-y-5">
                  <div>
                    <span class="block text-[10px] font-bold text-zinc-400 uppercase tracking-wider">
                      {billingData.status.includes("TERBAYAR") ? "Jumlah Terbayar" : "Jumlah Pembayaran"}
                    </span>
                    <span class="text-xl font-black text-zinc-950 tracking-tight block mt-1">{formatRupiah(billingData.total_tagih)}</span>
                  </div>

                  <div class="border-t border-zinc-150 pt-4 space-y-2.5 text-xs">
                    <div class="flex justify-between">
                      <span class="text-zinc-500">Tahun Ajaran</span>
                      <span class="font-medium text-zinc-800">{billingData.tahun_ajaran}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-zinc-500">Status Pembayaran</span>
                      <span class="font-medium text-zinc-800">{billingData.status_pembayaran}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-zinc-500">Metode</span>
                      <span class="font-medium text-zinc-800">{billingData.via || '-'}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-zinc-500">Tanggal</span>
                      <span class="font-mono text-zinc-650">{billingData.tanggal ? billingData.tanggal.split(' ')[0] : '-'}</span>
                    </div>
                  </div>

                  {/* Breakdown Komponen Tagihan - only show if status is NOT fully paid */}
                  {!billingData.status.includes("TERBAYAR") && (
                    <div class="border-t border-zinc-150 pt-4 space-y-2">
                      <span class="block text-[9px] font-bold text-zinc-400 uppercase tracking-wider">Rincian Tagihan</span>
                      <div class="space-y-1.5 text-[11px] font-mono">
                        {billingData.SKS_sekarang > 0 && (
                          <div class="flex justify-between text-zinc-600">
                            <span>Biaya SKS</span>
                            <span class="font-semibold text-zinc-800">{formatRupiah(billingData.SKS_sekarang)}</span>
                          </div>
                        )}
                        {billingData.SPP_sekarang > 0 && (
                          <div class="flex justify-between text-zinc-600">
                            <span>Biaya SPP</span>
                            <span class="font-semibold text-zinc-800">{formatRupiah(billingData.SPP_sekarang)}</span>
                          </div>
                        )}
                        {billingData.GDG_sekarang > 0 && (
                          <div class="flex justify-between text-zinc-600">
                            <span>Biaya Gedung</span>
                            <span class="font-semibold text-zinc-800">{formatRupiah(billingData.GDG_sekarang)}</span>
                          </div>
                        )}
                        {billingData.MOD_sekarang > 0 && (
                          <div class="flex justify-between text-zinc-600">
                            <span>Modul/Lainnya</span>
                            <span class="font-semibold text-zinc-800">{formatRupiah(billingData.MOD_sekarang)}</span>
                          </div>
                        )}
                        {billingData.BK_sekarang > 0 && (
                          <div class="flex justify-between text-zinc-600">
                            <span>Buku</span>
                            <span class="font-semibold text-zinc-800">{formatRupiah(billingData.BK_sekarang)}</span>
                          </div>
                        )}
                        {billingData.POLI_sekarang > 0 && (
                          <div class="flex justify-between text-zinc-600">
                            <span>Poliklinik</span>
                            <span class="font-semibold text-zinc-800">{formatRupiah(billingData.POLI_sekarang)}</span>
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                </CardContent>
              </Card>
            ) : (
              <Card className="shadow-sm border border-zinc-200 bg-white p-5 text-center">
                <span class="text-zinc-500 text-xs font-medium">Data tagihan tidak tersedia.</span>
              </Card>
            )}
          </div>
        </div>

        <!-- Transcript Section -->
        <TranscriptView transcript={transcriptData} khsHeader={khsHeaderData} client:load />
      )}
    </main>
  </div>
</Layout>
