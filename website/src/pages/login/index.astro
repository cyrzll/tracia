---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/db';
import { User } from '../../lib/schema';
import { eq, and } from 'drizzle-orm';
import { generateAccessToken, generateRefreshToken } from '../../utils/jwt';
import { validateAdminSession } from '../../utils/auth';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';

let errorMessage = '';
let successMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const username = data.get('username')?.toString() || '';
    const password = data.get('password')?.toString() || '';

    if (!username || !password) {
      errorMessage = 'Username dan password wajib diisi.';
    } else {
      // 1. Query user with matching credentials and admin level in local DB
      const users = await db.select().from(User).where(
        and(
          eq(User.username, username),
          eq(User.password, password),
          eq(User.level, 'admin')
        )
      );

      if (users.length > 0) {
        const payload = {
          uid: users[0].uid,
          username: users[0].username,
          name: users[0].name,
          level: users[0].level
        };

        // Generate JWT Access & Refresh Tokens
        const accessToken = await generateAccessToken(payload);
        const refreshToken = await generateRefreshToken(payload);

        // Set secure cookies for tokens
        Astro.cookies.set('admin_access_token', accessToken, {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: 60 * 15 // 15 minutes
        });

        Astro.cookies.set('admin_refresh_token', refreshToken, {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: 60 * 60 * 24 * 7 // 7 days
        });

        successMessage = 'Login berhasil! Mengalihkan ke dashboard...';
        return Astro.redirect('/dash/admin');
      } else {
        // 2. Try calling SIADIN API login
        try {
          const response = await fetch('https://api.dinus.ac.id/api/v1/siadin/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ username, password })
          });

          if (response.ok) {
            const result = await response.json();
            if (result && result.code === 200 && result.data && result.data.access_token) {
              // Store SIADIN access token
              Astro.cookies.set('mhs_access_token', result.data.access_token, {
                path: '/',
                httpOnly: true,
                secure: true,
                sameSite: 'lax',
                maxAge: 60 * 60 * 2 // 2 hours
              });

              successMessage = 'Login Mahasiswa berhasil! Mengalihkan ke dashboard...';
              return Astro.redirect('/dash/mhs');
            }
          }
        } catch (apiError) {
          console.error('SIADIN API Login failed:', apiError);
        }

        errorMessage = 'Username, password salah, atau Anda tidak memiliki akses.';
      }
    }
  } catch (error) {
    if (error instanceof Error) {
      errorMessage = error.message;
    } else {
      errorMessage = 'Terjadi kesalahan internal pada server.';
    }
  }
}

// Redirect if already logged in as Admin
const { isLoggedIn: isAdminLoggedIn } = await validateAdminSession(Astro.cookies);
if (isAdminLoggedIn) {
  return Astro.redirect('/dash/admin');
}

// Redirect if already logged in as Student (SIADIN)
const mhsSession = Astro.cookies.get('mhs_access_token');
if (mhsSession) {
  return Astro.redirect('/dash/mhs');
}
---

<Layout 
  title="Masuk Portal TRACIA AI | Student Risk Predictor"
  description="Masuk ke portal akademik TRACIA AI untuk memantau status risiko akademis mahasiswa secara real-time."
>
  <div class="relative flex items-center justify-center min-h-screen bg-zinc-50 text-zinc-800">
    <div class="w-full max-w-sm p-4 m-4">
      <!-- Logo or Brand Header -->
      <div class="mb-8 text-center">
        <div class="inline-flex items-center justify-center w-10 h-10 mb-3 border border-zinc-200 bg-white">
          <span class="text-zinc-900 font-black text-sm">T</span>
        </div>
        <h1 class="text-xl font-bold tracking-tight text-zinc-900">
          TRACIA AI
        </h1>
        <p class="text-[10px] tracking-widest uppercase font-semibold text-zinc-500 mt-1">
          Student Risk Predictor &bull; Admin Portal
        </p>
      </div>

      <!-- Login Shadcn Card -->
      <Card className="rounded shadow-sm border border-zinc-200 bg-white">
        <CardHeader>
          <CardTitle className="text-zinc-900">Masuk Akun Admin</CardTitle>
          <CardDescription className="text-zinc-500">Masukkan kredensial untuk mengakses sistem pemantauan.</CardDescription>
        </CardHeader>
        <CardContent>
          {errorMessage && (
            <div class="flex items-start gap-2 p-3 mb-4 text-xs text-zinc-800 border border-zinc-200 bg-zinc-50">
              <span class="text-zinc-900 font-bold">[!]</span>
              <span>{errorMessage}</span>
            </div>
          )}

          {successMessage && (
            <div class="flex items-start gap-2 p-3 mb-4 text-xs text-zinc-800 border border-zinc-200 bg-zinc-50">
              <span class="text-zinc-900 font-bold">[✓]</span>
              <span>{successMessage}</span>
            </div>
          )}

          <form method="POST" class="space-y-4">
            <!-- Username Input -->
            <div class="space-y-1.5">
              <label for="username" class="block text-[10px] font-bold uppercase tracking-wider text-zinc-650">
                Username
              </label>
              <Input
                id="username"
                name="username"
                type="text"
                required
                placeholder="admin"
                className="bg-white border-zinc-200 text-zinc-900 placeholder-zinc-400 focus:ring-zinc-400 focus:border-zinc-400"
              />
            </div>

            <!-- Password Input -->
            <div class="space-y-1.5">
              <label for="password" class="block text-[10px] font-bold uppercase tracking-wider text-zinc-650">
                Password
              </label>
              <Input
                id="password"
                name="password"
                type="password"
                required
                placeholder="••••••••"
                className="bg-white border-zinc-200 text-zinc-900 placeholder-zinc-400 focus:ring-zinc-400 focus:border-zinc-400"
              />
            </div>

            <!-- Remember & Forgot Password -->
            <div class="flex items-center justify-between text-[10px] text-zinc-500 pt-1">
              <label class="flex items-center gap-1.5 cursor-pointer hover:text-zinc-800 select-none">
                <input type="checkbox" class="w-3 h-3 rounded border-zinc-200 bg-white text-zinc-900 focus:ring-zinc-400" />
                Ingat saya
              </label>
              <a href="#" class="hover:text-zinc-800 transition-colors">
                Lupa Password?
              </a>
            </div>

            <!-- Submit Button -->
            <Button
              type="submit"
              className="w-full mt-2 cursor-pointer bg-zinc-900 text-zinc-50 hover:bg-zinc-800"
            >
              Masuk Ke Portal
            </Button>
          </form>
        </CardContent>
      </Card>

      <!-- Footer Info -->
      <p class="mt-8 text-[9px] text-center text-zinc-500 tracking-wider uppercase">
        &copy; {new Date().getFullYear()} TRACIA AI. All rights reserved.
      </p>
    </div>
  </div>
</Layout>
