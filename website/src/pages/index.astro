---
import Layout from '../layouts/Layout.astro';
import { validateAdminSession } from '../utils/auth';
import { LandingPagePanel } from '@/components/LandingPagePanel';

// Check if admin is already logged in
const { isLoggedIn, adminInfo } = await validateAdminSession(Astro.cookies);
const adminName = adminInfo ? adminInfo.name : null;
---

<Layout 
  title="TRACIA AI | Student Risk Predictor"
  description="Platform analisis berbasis Machine Learning (XGBoost) untuk memantau performa akademis dan mendeteksi dini probabilitas risiko dropout mahasiswa."
>
  <LandingPagePanel isLoggedIn={isLoggedIn} adminName={adminName} client:load />
</Layout>
