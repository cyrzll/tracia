---
import Layout from '../layouts/Layout.astro';
import { validateAdminSession } from '../utils/auth';

// Check if admin is already logged in
const { isLoggedIn, adminInfo } = await validateAdminSession(Astro.cookies);
---

<Layout 
  title="TRACIA AI | Student Risk Predictor"
  description="Platform analisis berbasis Machine Learning (XGBoost) untuk memantau performa akademis dan mendeteksi dini probabilitas risiko dropout mahasiswa."
>
  <div class="min-h-screen bg-zinc-50 text-zinc-850 selection:bg-zinc-200 selection:text-black">
    <!-- Top Navigation Bar -->
    <header class="border-b border-zinc-200 bg-white/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 border-2 border-zinc-900 flex items-center justify-center bg-zinc-900">
            <span class="text-white font-black text-xs">T</span>
          </div>
          <span class="font-bold text-sm tracking-wider text-zinc-900">TRACIA AI</span>
        </div>

        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium border border-zinc-200 text-zinc-500 bg-white">
            <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 animate-pulse"></span>
            AI Engine Active
          </span>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="max-w-4xl mx-auto px-4 pt-24 pb-20 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-200 bg-white text-zinc-500 text-xs font-medium mb-8">
        <span>Academic Update Syncing Active</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-zinc-950 mb-6 leading-tight font-sans">
        Deteksi Dini & Analisis <br/>
        <span class="text-zinc-500">
          Risiko Dropout Mahasiswa
        </span>
      </h1>

      <p class="max-w-xl mx-auto text-sm sm:text-base text-zinc-500 leading-relaxed mb-12">
        Platform analitik minimalis berbasis kecerdasan buatan (Machine Learning XGBoost & Optuna) untuk memantau, memprediksi, dan memberikan intervensi tepat sasaran guna menurunkan tingkat dropout perguruan tinggi secara proaktif.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-24">
        {isLoggedIn ? (
          <a
            href="/dash/admin"
            class="px-6 py-3 rounded bg-zinc-900 hover:bg-zinc-800 text-sm font-semibold text-zinc-50 transition-all duration-200 w-full sm:w-auto text-center shadow-sm"
          >
            Dashboard Admin ({adminInfo.name})
          </a>
        ) : (
          <a
            href="/login"
            class="px-6 py-3 rounded bg-zinc-900 hover:bg-zinc-800 text-sm font-semibold text-zinc-50 transition-all duration-200 w-full sm:w-auto text-center shadow-sm"
          >
            Masuk Portal Admin
          </a>
        )}
        <a
          href="https://github.com/tracia-AI/Student-Risk-Predictor"
          target="_blank"
          class="px-6 py-3 rounded border border-zinc-200 bg-white hover:bg-zinc-50 text-sm font-semibold text-zinc-800 transition-all duration-200 w-full sm:w-auto text-center shadow-sm"
        >
          Dokumentasi API
        </a>
      </div>

      <!-- Feature Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left border-t border-zinc-200 pt-16">
        <!-- Feature 1 -->
        <div class="p-6 rounded-lg border border-zinc-200 bg-white shadow-sm hover:border-zinc-350 transition-colors duration-200">
          <div class="w-8 h-8 rounded border border-zinc-200 bg-zinc-50 flex items-center justify-center text-zinc-800 font-bold mb-4">
            01
          </div>
          <h3 class="text-sm font-bold text-zinc-900 mb-2 uppercase tracking-wide">Prediksi XGBoost + Optuna</h3>
          <p class="text-xs text-zinc-500 leading-relaxed">
            Klasifikasi data mahasiswa secara instan berdasarkan probabilitas statistik yang disetel otomatis menggunakan hyperparameter tuning Optuna.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-6 rounded-lg border border-zinc-200 bg-white shadow-sm hover:border-zinc-350 transition-colors duration-200">
          <div class="w-8 h-8 rounded border border-zinc-200 bg-zinc-50 flex items-center justify-center text-zinc-800 font-bold mb-4">
            02
          </div>
          <h3 class="text-sm font-bold text-zinc-900 mb-2 uppercase tracking-wide">Explainable AI (SHAP)</h3>
          <p class="text-xs text-zinc-500 leading-relaxed">
            Transparansi penuh dalam pengambilan keputusan model AI. Mengetahui secara presisi faktor-faktor akademis atau pembayaran yang memicu risiko.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-6 rounded-lg border border-zinc-200 bg-white shadow-sm hover:border-zinc-350 transition-colors duration-200">
          <div class="w-8 h-8 rounded border border-zinc-200 bg-zinc-50 flex items-center justify-center text-zinc-800 font-bold mb-4">
            03
          </div>
          <h3 class="text-sm font-bold text-zinc-900 mb-2 uppercase tracking-wide">Tindakan Prioritas</h3>
          <p class="text-xs text-zinc-500 leading-relaxed">
            Mengelompokkan mahasiswa ke tingkat kerawanan High, Medium, dan Low untuk menentukan langkah preventif yang paling efisien.
          </p>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-200 bg-zinc-100/50 py-8 text-center text-[10px] tracking-wider text-zinc-500 uppercase">
      &copy; {new Date().getFullYear()} TRACIA AI. All rights reserved.
    </footer>
  </div>
</Layout>
