---
import Layout from '../layouts/Layout.astro';
import Galaxy from '../components/background/galaxy';
import { LanguageSelector } from '../components/navbar/LanguageSelector';
---

<Layout 
  title="404 - Page Dropped Out | TRACIA AI"
  description="The requested page has dropped out of our system. Let's get you back on track."
>
  <style is:global>
    html, body {
      background-color: #050505 !important;
      overflow: hidden !important;
      height: 100% !important;
    }
  </style>

  <!-- Starfield Background -->
  <div class="fixed inset-0 z-0 pointer-events-none opacity-40">
    <Galaxy 
      client:load 
      mouseRepulsion
      mouseInteraction
      density={0.6}
      glowIntensity={0.3}
      saturation={0}
      hueShift={140}
      twinkleIntensity={0.3}
      rotationSpeed={0.1}
      repulsionStrength={2}
      autoCenterRepulsion={0}
      starSpeed={0.5}
      speed={1}
    />
  </div>

  <div class="relative z-10 flex flex-col items-center justify-center min-h-screen text-white px-4">
    <!-- Top Right Language Selector -->
    <div class="absolute top-4 right-4 z-50">
      <LanguageSelector client:load />
    </div>

    <!-- Center Card -->
    <div class="w-full max-w-xl text-center space-y-8">
      <!-- Logo -->
      <div class="flex justify-center mb-2">
        <a href="/" class="inline-flex items-center justify-center w-12 h-12 border border-zinc-800 bg-zinc-950 rounded-xl hover:scale-105 transition-transform duration-300">
          <img src="/favicon.ico" alt="TRACIA Logo" class="w-7 h-7 object-contain" />
        </a>
      </div>

      <!-- Main Visual Container -->
      <div class="relative p-8 md:p-12 rounded-3xl border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-xl shadow-2xl shadow-indigo-500/5 overflow-hidden">
        <!-- Floating light effect in background of card -->
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 space-y-6">
          <!-- 404 Title -->
          <h1 class="text-8xl md:text-9xl font-extrabold tracking-tighter bg-gradient-to-b from-white via-zinc-200 to-zinc-650 bg-clip-text text-transparent select-none animate-pulse">
            404
          </h1>

          <!-- Error Badge -->
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-red-500/30 bg-red-950/20 text-red-400 text-xs font-mono font-bold tracking-wider uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
            Status: Page Dropped Out
          </div>

          <!-- Description -->
          <div class="space-y-3">
            <h2 class="text-xl md:text-2xl font-bold tracking-tight text-white">
              Lost in Academic Space
            </h2>
            <p class="text-sm text-zinc-400 max-w-md mx-auto leading-relaxed">
              Just like student dropout risks, missing links can be prevented. The page you are looking for does not exist, has been moved, or is taking a leave of absence.
            </p>
          </div>

          <!-- Divider -->
          <div class="h-px w-full bg-zinc-850"></div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-3 justify-center items-center pt-2">
            <a 
              href="/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold rounded-xl bg-white text-black hover:bg-zinc-200 transition-all duration-300 shadow-lg shadow-white/5 hover:scale-[1.02] active:scale-[0.98]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-home"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Go Back Home
            </a>
            <a 
              href="/login"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold rounded-xl border border-zinc-800 bg-zinc-900/50 hover:bg-zinc-800 text-white transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="10" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
              Portal Login
            </a>
          </div>
        </div>
      </div>

      <!-- Footer Info -->
      <p class="text-[10px] text-zinc-500 uppercase tracking-widest">
        TRACIA AI Monitoring &bull; Academic Shield
      </p>
    </div>
  </div>
</Layout>
